<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dev Mode / Benchmark Cache"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Skip benchmarks on install by creating a cached profile file."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Mock Compute GFLOPS">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDevGflops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="14.5" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Mock Memory Bandwidth (MB/s)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDevMemBw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="4500" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvCachePathInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Target: /data/user/0/org.meshllm.node/files/meshllm_bench_profile.json"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnSaveDevProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#00C853"
        android:text="Save &amp; Cache to File (Skip Tests)"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnClearCacheFile"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Delete Cache File (Force Re-test)"
        android:textColor="#FF5252" />

</LinearLayout>
