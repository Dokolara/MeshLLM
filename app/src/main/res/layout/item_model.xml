<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardModelItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#3A3A3A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Title & Provider / Category row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TinyStories-15M"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStarterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="#1B5E20"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="TEST STARTER"
                android:textColor="#A5D6A7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tvModelCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#263238"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Ultra-Small"
                android:textColor="#80CBC4"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Provider and HuggingFace repo -->
        <TextView
            android:id="@+id/tvModelProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Microsoft / Eldan &amp; Li • roneneldan/TinyStories-15M"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Specs Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModelParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#37474F"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="15M Params"
                android:textColor="#ECEFF1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelLayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#4527A0"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="6 Layers"
                android:textColor="#D1C4E9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#004D40"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="~18 MB (INT8)"
                android:textColor="#80CBC4"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvModelDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#212121"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="288 Dim"
                android:textColor="#9E9E9E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvModelDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ultra-lightweight synthetic reasoning model. Executes with negligible RAM and thermal load."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Massive Model OOM Warning Banner -->
        <TextView
            android:id="@+id/tvOomWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#3E2723"
            android:padding="8dp"
            android:text="⚠️ Massive Model: Single phone RAM will OOM crash! Must be split across 4 to 8 mesh phones."
            android:textColor="#FFAB91"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Bottom action & status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActiveStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ LOADED"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvItemDownloadStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not Downloaded"
                android:textColor="#FF9800"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnItemDownload"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Download"
                android:textColor="#00E676"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSelectModel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="Load into Mesh"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
