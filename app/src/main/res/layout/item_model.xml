<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardModelItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Provider / Category row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TinyStories-15M"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStarterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="STARTER"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tvModelCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Ultra-Small"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Provider and HuggingFace repo -->
        <TextView
            android:id="@+id/tvModelProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Microsoft / Eldan &amp; Li • roneneldan/TinyStories-15M"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Specs Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModelParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="15M Params"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvModelLayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="6 Layers"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="~18 MB (INT8)"
                android:textColor="@color/accent_mint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvModelDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="288 Dim"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvModelDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Ultra-lightweight synthetic reasoning model. Executes with negligible RAM and thermal load."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Massive Model OOM Warning Banner -->
        <TextView
            android:id="@+id/tvOomWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal_rounded"
            android:padding="8dp"
            android:text="Large Model: Must be partitioned across 4 to 8 mesh phones to fit RAM."
            android:textColor="@color/status_orange"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Bottom action & status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActiveStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● ACTIVE IN MESH"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvItemDownloadStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not Downloaded"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnItemDownload"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Download"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/border_subtle" />

            <Button
                android:id="@+id/btnSelectModel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Load"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
