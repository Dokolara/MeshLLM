<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSliderNodeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Node 0 (Master) - Moto G45"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSliderLayerRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 layers (L0..L7)"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderNodeLayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:valueFrom="0.0"
        android:valueTo="32.0"
        android:stepSize="1.0"
        app:thumbColor="@color/accent"
        app:trackColorActive="@color/accent"
        app:trackColorInactive="#424242"
        app:haloColor="#3300E676" />

</LinearLayout>
