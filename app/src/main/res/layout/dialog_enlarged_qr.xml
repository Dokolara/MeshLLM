<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master Pairing QR Code"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Point another device's camera here to join the cluster"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="4dp">

        <ImageView
            android:id="@+id/ivEnlargedQr"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:contentDescription="Enlarged Master QR Code" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvEnlargedDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#121212"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:text="Master IP:Port\nToken: MESH-XXXX-XXXX\nModel: ..."
        android:textColor="#00E676"
        android:textSize="12sp" />

</LinearLayout>
